---
import { tagHref } from "../utils/tags";

interface Props {
  tags: [string, number][];
  /** 選択中のタグ。未指定なら「すべて」を選択状態にする */
  active?: string;
  /** 「すべて」チップのリンク先と件数 */
  all?: { href: string; count: number };
  /** サイドレール用。チップではなく「名前 + 件数」の縦 1 列で並べる */
  vertical?: boolean;
}

const { tags, active, all, vertical = false } = Astro.props;
---

<nav class:list={["chips", { vertical }]} aria-label="タグで絞り込み">
  {all && (
    <a href={all.href} aria-current={active === undefined ? "page" : undefined}>
      すべて <span class="count">{all.count}</span>
    </a>
  )}
  {tags.map(([tag, count]) => (
    <a href={tagHref(tag)} aria-current={active === tag ? "page" : undefined}>
      #{tag} <span class="count">{count}</span>
    </a>
  ))}
</nav>

<style>
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
a {
  padding: 3px 9px;
  background: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: 3px;
  font: 400 11px var(--font-mono);
  color: var(--muted);
}
a:hover {
  border-color: var(--accent);
  color: var(--accent);
  text-decoration: none;
}
a[aria-current="page"] {
  background: var(--header-bg);
  border-color: var(--header-bg);
  color: var(--header-fg);
}
.count {
  color: var(--faint);
}
/* 縦 1 列はレールが横に並ぶ幅だけ。狭い画面ではチップに戻す(index.astro の境界と合わせる) */
@media (min-width: 861px) {
  .vertical {
    flex-direction: column;
    flex-wrap: nowrap;
    gap: 0;
  }
  .vertical a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 4px 6px;
    background: none;
    border: none;
    border-radius: 3px;
    font-size: 12px;
  }
  .vertical a:hover {
    background: var(--surface-strong);
  }
  .vertical a[aria-current="page"] {
    background: none;
    color: var(--accent);
  }
}
</style>
