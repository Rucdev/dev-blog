---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import FormattedDate from "../components/FormattedDate.astro";
import { estimateReadingTime } from "../utils/readingTime";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"blog">["data"] & {
  body?: string;
  headings: MarkdownHeading[];
  prevPost: CollectionEntry<"blog"> | null;
  nextPost: CollectionEntry<"blog"> | null;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  body,
  headings,
  prevPost,
  nextPost,
} = Astro.props;

const toc = headings.filter((h) => h.depth === 2);
const readingMinutes = estimateReadingTime(body ?? "");
---

<Layout title={title} description={description}>
  <div class="article-grid">
    <article class="prose-wrap">
      <div class="meta">
        <FormattedDate date={pubDate} />
        {tags.map((tag) => <span>#{tag}</span>)}
        <span>{readingMinutes} min read</span>
      </div>
      <h1 class="title">{title}</h1>
      {updatedDate && (
        <p class="updated">
          Last updated on <FormattedDate date={updatedDate} />
        </p>
      )}
      <div class="prose">
        <slot />
      </div>
      {(prevPost || nextPost) && (
        <nav class="post-nav">
          <span>
            {prevPost && (
              <a href={`/blog/${prevPost.id}/`}>← {prevPost.data.title}</a>
            )}
          </span>
          <span class="next">
            {nextPost && (
              <a href={`/blog/${nextPost.id}/`}>{nextPost.data.title} →</a>
            )}
          </span>
        </nav>
      )}
    </article>
    {toc.length > 0 && (
      <aside class="toc">
        <p class="toc-label">CONTENTS</p>
        <div class="toc-list">
          {toc.map((heading) => (
            <a href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </div>
      </aside>
    )}
  </div>
</Layout>

<style>
.article-grid {
  max-width: 1120px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 232px;
  gap: 44px;
  padding: 40px 28px 56px;
}
.prose-wrap {
  max-width: 720px;
}
.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin: 0 0 14px;
  font: 400 11.5px var(--font-mono);
  color: var(--faint);
}
.title {
  font: 700 30px / 1.55 var(--font-sans);
  letter-spacing: -0.015em;
  margin: 0 0 18px;
}
.updated {
  margin: -8px 0 18px;
  font: 400 12px var(--font-sans);
  font-style: italic;
  color: var(--faint);
}
.post-nav {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 36px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
  font: 400 12px var(--font-mono);
}
.post-nav .next {
  margin-left: auto;
  text-align: right;
}
.toc {
  align-self: start;
  position: sticky;
  top: 20px;
}
.toc-label {
  margin: 0 0 10px;
  font: 500 10.5px var(--font-mono);
  color: var(--faint);
  letter-spacing: 0.12em;
}
.toc-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font: 400 12px / 1.6 var(--font-sans);
  border-left: 1px solid var(--border);
  padding-left: 12px;
}
.toc-list a {
  color: var(--muted);
}
.toc-list a:hover {
  color: var(--accent);
}
@media (max-width: 860px) {
  .article-grid {
    grid-template-columns: 1fr;
  }
  .toc {
    position: static;
    order: -1;
  }
}
</style>
