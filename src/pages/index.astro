---
import { getCollection } from "astro:content";
import PostList from "../components/PostList.astro";
import TagList from "../components/TagList.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Layout from "../layouts/Layout.astro";
import { countTags } from "../utils/tags";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 10);
const tags = countTags(posts);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="listing">
    <div class="main">
      <p class="prompt">$ ls -lt ~/posts</p>
      <PostList posts={recentPosts} />
      <p class="more">
        showing {recentPosts.length} of {posts.length} —
        <a href="/archive">more</a>
      </p>
    </div>
    <aside class="rail">
      <p class="prompt">$ ls ~/tags</p>
      <TagList tags={tags} all={{ href: "/", count: posts.length }} vertical />
    </aside>
  </section>
</Layout>

<style>
.listing {
  max-width: 1120px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 232px;
  gap: 44px;
  padding: 34px 28px 56px;
}
.rail {
  align-self: start;
  position: sticky;
  top: 20px;
  max-height: calc(100vh - 40px);
  overflow-y: auto;
}
.prompt {
  margin: 0 0 14px;
  font: 400 12px var(--font-mono);
  color: var(--accent);
  letter-spacing: 0.04em;
}
.more {
  margin: 18px 6px 0;
  font: 400 11.5px var(--font-mono);
  color: var(--faint);
}
@media (max-width: 860px) {
  .listing {
    grid-template-columns: 1fr;
    gap: 36px;
  }
  .rail {
    position: static;
    max-height: none;
  }
}
</style>
